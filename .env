# Copy to .env, then restart Metro with:  npx expo start -c
# iOS Simulator + Laravel Herd:      http://matchbet.test/api/v1
# iOS Simulator + php artisan serve: http://127.0.0.1:8000/api/v1
# Android emulator:                  http://10.0.2.2:8000/api/v1
# Real phone on the same Wi-Fi:      http://<your-mac-LAN-IP>:8000/api/v1   (serve with: php artisan serve --host=0.0.0.0)
#EXPO_PUBLIC_API_URL=http://matchbet.test/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional live updates (Laravel Reverb). Leave empty to use polling every 15s.
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# Optional social login (buttons appear only when set)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Optional in-app subscriptions for club owners (RevenueCat public SDK keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
